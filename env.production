# Configuration Production Mosala
NODE_ENV=production

# Domaines
DOMAIN_MAIN=projetmosala.org
DOMAIN_API=api.projetmosala.org
DOMAIN_CMS=cms.projetmosala.org
DOMAIN_ADMIN=admin.projetmosala.org
DOMAIN_SUPPORT=support.projetmosala.org

# Base de données
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=mosala

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-in-production
STRAPI_JWT_SECRET=strapi-jwt-secret-change-in-production
STRAPI_ADMIN_JWT_SECRET=strapi-admin-jwt-secret-change-in-production
STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=salt-change-in-production
STRAPI_TRANSFER_TOKEN_SALT=salt-change-in-production

# MySQL
MYSQL_ROOT_PASSWORD=root-change-in-production

# URLs des services
VITE_API_URL=https://api.projetmosala.org
VITE_CMS_URL=https://cms.projetmosala.org
VITE_ADMIN_URL=https://admin.projetmosala.org
VITE_SUPPORT_URL=https://support.projetmosala.org

# CORS
CORS_ORIGIN=https://projetmosala.org

# Email pour Let's Encrypt
LETSENCRYPT_EMAIL=admin@projetmosala.org

# Ports
FRONTEND_PORT=80
BACKEND_PORT=4002
STRAPI_PORT=1337
TRAEFIK_DASHBOARD_PORT=8080

# Docker
DOCKER_USERNAME=galoycg
VITE_STRAPI_URL=https://cms.projetmosala.org


