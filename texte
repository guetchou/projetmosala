# ===========================================
# Configuration Mosala - avec Supabase PostgreSQL
# ===========================================

# Frontend Configuration
VITE_API_URL=http://localhost:4002
VITE_STRAPI_URL=http://localhost:1337
VITE_APP_NAME=Mosala
VITE_APP_VERSION=1.0.0

# Backend NestJS Configuration - Supabase PostgreSQL
# Format de SUPABASE_URL: postgresql://user:password@host:port/database
# Récupérez ces informations depuis votre projet Supabase
# https://app.supabase.com/ > Project Settings > Database
DB_HOST=your-supabase-host.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASS=your-supabase-postgres-password
DB_NAME=postgres
DATABASE_URL=postgresql://postgres:your-supabase-password@your-supabase-host.supabase.co:5432/postgres

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d
PORT=4002
NODE_ENV=development

# Supabase Configuration (Optionnel pour intégration avancée)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Backend Python (FastAPI) Configuration
PYTHON_API_PORT=1188

# Strapi CMS Configuration (Optionnel)
STRAPI_DATABASE_CLIENT=mysql
STRAPI_DATABASE_HOST=localhost
STRAPI_DATABASE_PORT=3306
STRAPI_DATABASE_NAME=mosala

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Environnement
LOG_LEVEL=debug



